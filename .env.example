# ─────────────────────────────────────────────
# VulnGuard — Environment Configuration
# Copy file này thành .env và chỉnh sửa theo môi trường
# ─────────────────────────────────────────────

# Port Web UI / API chạy trên máy local
VULNGUARD_PORT=8080

# Thư mục source code cần scan (mount vào container)
# Ví dụ: /home/user/projects/my-app hoặc /Users/datnt/projects/my-app
SCAN_WORKSPACE=/tmp

# Allow-list thư mục được scan (CSV). Rỗng → Docker: /workspace; native: thư mục home.
# scan_path ngoài các thư mục này bị từ chối (400). Áp dụng cho MỌI vai trò.
SCAN_ALLOWED_ROOTS=
# Thư mục File Assistant được đọc (CSV). Rỗng → dùng SCAN_ALLOWED_ROOTS.
FILE_ASSISTANT_ALLOWED_ROOTS=
# File Assistant chưa có UI → mặc định TẮT (API trả 404). Bật: true
FEATURE_FILE_ASSISTANT=false

# ─────────────────────────────────────────────
# Docker Socket — CHỈ cần khi quét image có ở máy local (tuỳ chọn)
# ─────────────────────────────────────────────
# Mặc định app KHÔNG mount docker.sock (mount ":ro" vẫn cho tạo container privileged → root host).
# Muốn quét image local: dùng override socket-proxy chỉ-đọc
#   docker compose -f docker-compose.yml -f docker-compose.local-images.yml up -d
# DOCKER_SOCK dưới đây là đường dẫn socket mà CONTAINER PROXY mount (không phải app).
# Docker Desktop trên macOS: ls -la /var/run/docker.sock ~/.docker/run/docker.sock 2>/dev/null
#   DOCKER_SOCK=$HOME/.docker/run/docker.sock
# DOCKER_SOCK=/var/run/docker.sock   (thường OK)
#
# Nếu không cần scan container image, có thể comment dòng này
# (scanner vẫn hoạt động cho SAST/SCA/IaC/Secrets)
DOCKER_SOCK=/var/run/docker.sock

# IP reverse proxy được phép đặt X-Forwarded-For (mặc định 127.0.0.1 = không tin header)
# FORWARDED_ALLOW_IPS=127.0.0.1

# ─────────────────────────────────────────────
# Ollama AI — Đã cài sẵn trên máy local
# ─────────────────────────────────────────────
# VulnGuard gọi Ollama API trực tiếp trên máy bạn (không cần Docker)
# Đảm bảo Ollama đang chạy: ollama serve
# Kiểm tra: curl http://localhost:11434/api/tags
#
# Model mặc định — phải đã pull sẵn: ollama pull <model>
# Hoặc chọn/pull trong Web UI → Settings
#
# Gợi ý model:
#   llama3.2            — Nhẹ, nhanh (~2GB)
#   deepseek-coder:6.7b — Tốt nhất cho code security (~4GB)
#   qwen2.5-coder:7b    — Tốt cho code analysis (~5GB)
#   codellama:7b        — Chuyên code (~4GB)
#   mistral:7b-instruct — Cân bằng (~4GB)
OLLAMA_MODEL=llama3.2

# Timeout AI response (giây) — tăng nếu máy chậm
OLLAMA_TIMEOUT=120

# ─────────────────────────────────────────────
# Co-work (AI sửa code) — Coworker Host Service
# ─────────────────────────────────────────────
# Tính năng Co-work cần 1 service nhỏ chạy NATIVE trên máy host (giống
# Ollama) để đọc/sửa file & chạy lệnh ở các folder ngoài Docker volume.
# Chạy: bash coworker_host/run.sh   (mặc định port 8765)
COWORKER_URL=http://host.docker.internal:8765
COWORKER_TIMEOUT=30

# ─────────────────────────────────────────────
# VulnGuard Settings
# ─────────────────────────────────────────────

# Số scan tối đa lưu mỗi project (1-5)
MAX_SCANS_PER_PROJECT=5

# Mức severity tối thiểu để BLOCK approve (CRITICAL, HIGH, MEDIUM, LOW)
BLOCK_SEVERITY_THRESHOLD=HIGH

# App environment
APP_ENV=production

# ─────────────────────────────────────────────
# Auth (đăng nhập Web UI) — Sprint 1
# ─────────────────────────────────────────────
# Lần đầu mở app sẽ yêu cầu tạo tài khoản ADMIN. Đặt false CHỈ khi chạy local 1 người.
AUTH_ENABLED=true
# Khi AUTH_ENABLED=false: Co-work, File Assistant và mọi route quản trị bị khoá; Host chỉ loopback.
# Host header bổ sung (csv), vd khi truy cập qua tên miền nội bộ:
ALLOWED_HOSTS=
# CORS: để trống = same-origin (UI đi kèm không cần). Liệt kê origin client trình duyệt bên thứ ba (csv).
CORS_ALLOW_ORIGINS=
# false = tắt /docs, /redoc, /openapi.json (khi bật vẫn yêu cầu đăng nhập)
EXPOSE_API_DOCS=true
# SCM base_url: chặn SSRF. http chỉ khi SCM_ALLOW_HTTP=true; dải private cho on-prem mặc định cho phép.
SCM_ALLOW_HTTP=false
SCM_ALLOW_PRIVATE_HOSTS=true
# Secret ký session + mã hoá API key cloud AI. Để trống = tự sinh storage/secret.key.
# Nhiều instance / sau reverse proxy: đặt cố định 1 chuỗi ngẫu nhiên dài.
VULNGUARD_SECRET_KEY=
# Setup token cho lần tạo ADMIN đầu tiên. Trống → tự sinh vào storage/setup_token (0600), xoá sau khi setup xong.
VULNGUARD_SETUP_TOKEN=
SESSION_TTL_HOURS=12
# Bật khi chạy sau HTTPS (cookie Secure flag)
COOKIE_SECURE=false

# ─────────────────────────────────────────────
# Cloud AI (giảm false positive) — cấu hình chi tiết trong Web UI → Settings → AI Provider
# File lưu: storage/ai_config.json (API key được mã hoá). Các biến dưới chỉ là ghi chú.
# ─────────────────────────────────────────────
# mode: local_only (chỉ Ollama) | hybrid (Ollama + Claude xác minh) | cloud_only (toàn bộ Claude)
# provider: anthropic (Claude API — API key / WIF / environment) | bedrock (AWS IAM)

# ─────────────────────────────────────────────
# Web Scan (Nuclei)
# ─────────────────────────────────────────────
MAX_WEBSCANS_PER_DOMAIN=5
NUCLEI_TIMEOUT_MINUTES=60

# ─────────────────────────────────────────────
# SonarQube (Community) — SAST sâu, giảm false positive (tuỳ chọn)
# Dùng server sẵn có: trỏ URL + token. Hoặc bundled: docker compose --profile sonar up -d
# ─────────────────────────────────────────────
SONARQUBE_URL=
SONARQUBE_TOKEN=
# Bundled (profile sonar): SONARQUBE_URL=http://sonarqube:9000

# ─────────────────────────────────────────────
# Bảo mật triển khai (hardening)
# ─────────────────────────────────────────────
# ── Truy cập từ máy khác trong LAN (xem wiki "Truy cập từ máy khác trong LAN") ──
# VULNGUARD_BIND: địa chỉ bind. Mặc định 127.0.0.1 (chỉ máy này). Đặt 0.0.0.0 để mở LAN
# (cần AUTH_ENABLED=true; tạo ADMIN/setup token trước; đặt ALLOWED_HOSTS; khuyến nghị TLS + COOKIE_SECURE=true).
# Dùng cho cả Docker compose và run.sh/run.ps1 (VULNGUARD_HOST là alias deprecated).
VULNGUARD_BIND=127.0.0.1
# Proxy MITM của Pentest Agent (cổng 8788, Docker): bind RIÊNG, giữ loopback dù UI mở LAN.
PENTEST_PROXY_BIND=127.0.0.1
# Token xác thực giữa app và coworker_host (BẮT BUỘC cho tính năng Co-work).
# Sinh: openssl rand -hex 32  — đặt GIỐNG NHAU cho app (Docker) và coworker_host/run.sh
VULNGUARD_COWORKER_TOKEN=

# Chế độ exec của Coworker Host (chạy trên máy host, đọc bởi coworker_host/run.sh):
#   safe (mặc định) = chỉ lệnh đọc (ls cat head tail wc grep diff echo tree find git-readonly)
#   trusted         = lệnh khác (python3, npm, make...) chạy được SAU KHI xác nhận bằng confirm_id do server cấp
#   off             = tắt exec hoàn toàn
COWORKER_EXEC_MODE=safe
# (Khuyến nghị) giới hạn folder được cấp quyền trong các root này (phân tách bằng dấu phẩy). Rỗng = chỉ áp denylist.
COWORKER_ALLOWED_ROOTS=
