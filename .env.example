# ─────────────────────────────────────────────
# VulnGuard — Environment Configuration
# Copy file này thành .env và chỉnh sửa theo môi trường
# ─────────────────────────────────────────────

# Port Web UI / API chạy trên máy local
VULNGUARD_PORT=8080

# Thư mục source code cần scan (mount vào container)
# Ví dụ: /home/user/projects/my-app hoặc /Users/datnt/projects/my-app
SCAN_WORKSPACE=/tmp

# ─────────────────────────────────────────────
# Docker Socket — quan trọng trên macOS!
# ─────────────────────────────────────────────
# Docker Desktop trên macOS dùng socket tại một trong hai path sau.
# Chạy lệnh này để biết path đúng:
#   ls -la /var/run/docker.sock ~/.docker/run/docker.sock 2>/dev/null
#
# Nếu lỗi "no such file or directory", thử:
#   DOCKER_SOCK=/Users/datnt/.docker/run/docker.sock
#
# Nếu đang dùng OrbStack thay Docker Desktop:
#   DOCKER_SOCK=/var/run/docker.sock   (thường OK)
#
# Nếu không cần scan container image, có thể comment dòng này
# (scanner vẫn hoạt động cho SAST/SCA/IaC/Secrets)
DOCKER_SOCK=/var/run/docker.sock

# ─────────────────────────────────────────────
# Ollama AI — Đã cài sẵn trên máy local
# ─────────────────────────────────────────────
# VulnGuard gọi Ollama API trực tiếp trên máy bạn (không cần Docker)
# Đảm bảo Ollama đang chạy: ollama serve
# Kiểm tra: curl http://localhost:11434/api/tags
#
# Model mặc định — phải đã pull sẵn: ollama pull <model>
# Hoặc chọn/pull trong Web UI → Settings
#
# Gợi ý model:
#   llama3.2            — Nhẹ, nhanh (~2GB)
#   deepseek-coder:6.7b — Tốt nhất cho code security (~4GB)
#   qwen2.5-coder:7b    — Tốt cho code analysis (~5GB)
#   codellama:7b        — Chuyên code (~4GB)
#   mistral:7b-instruct — Cân bằng (~4GB)
OLLAMA_MODEL=llama3.2

# Timeout AI response (giây) — tăng nếu máy chậm
OLLAMA_TIMEOUT=120

# ─────────────────────────────────────────────
# VulnGuard Settings
# ─────────────────────────────────────────────

# Số scan tối đa lưu mỗi project (1-5)
MAX_SCANS_PER_PROJECT=5

# Mức severity tối thiểu để BLOCK approve (CRITICAL, HIGH, MEDIUM, LOW)
BLOCK_SEVERITY_THRESHOLD=HIGH

# App environment
APP_ENV=production
