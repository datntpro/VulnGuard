# ─────────────────────────────────────────────
# VulnGuard — Native Install Environment (KHÔNG dùng Docker)
# Copy file này thành .env và chỉnh sửa theo môi trường
# Dùng cùng với install/install.sh — xem docs/NATIVE_INSTALL.md
# ─────────────────────────────────────────────

# Đánh dấu đây là bản cài native (không Docker) — Web UI dùng để hiển thị
# hint scan path đúng (path thật trên máy, không phải path trong container)
DEPLOY_MODE=native

# Port Web UI / API
VULNGUARD_PORT=8080

# Thư mục source code cần scan — KHÔNG cần mount gì cả, đây là path THẬT
# trên máy (vì app chạy trực tiếp trên host, không qua container).
# Trong Web UI, nhập trực tiếp path tới project, ví dụ:
#   /home/user/projects/my-app
SCAN_WORKSPACE=/home/user/projects

# ─────────────────────────────────────────────
# Database & Storage — path THẬT trên máy (không phải /app/storage)
# ─────────────────────────────────────────────
# Để trống/dùng default sẽ tự trỏ vào ./storage trong project root
# (install.sh tự set absolute path khi cài đặt)
DATABASE_URL=sqlite:////opt/vulnguard/storage/db/vulnguard.db
SCANNER_CONFIG_FILE=/opt/vulnguard/storage/scanner_config.json

# ─────────────────────────────────────────────
# Ollama AI — Đã cài sẵn trên máy local
# ─────────────────────────────────────────────
# Bản native gọi Ollama qua localhost (không cần host.docker.internal)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ─────────────────────────────────────────────
# VulnGuard Settings
# ─────────────────────────────────────────────
MAX_SCANS_PER_PROJECT=5
BLOCK_SEVERITY_THRESHOLD=HIGH
APP_ENV=production

# ─────────────────────────────────────────────
# Lưu ý — Container scan (Trivy image / Grype)
# ─────────────────────────────────────────────
# Trên máy không có Docker, scan loại CONTAINER (quét image) sẽ không
# hoạt động đầy đủ (cần Docker daemon để pull/inspect image). Các loại
# scan khác (SAST, SCA, IaC, Secrets) hoạt động bình thường.
# Có thể tắt riêng "trivy-container" / để Grype chỉ quét filesystem
# trong Settings → Scanner Tools nếu không cần.
