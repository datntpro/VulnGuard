# vg egress ruleset — engagement 'e1' version 7 (do not edit; generated by render_nft)
table inet vg {}
delete table inet vg
table inet vg {
    set denied { type ipv4_addr; flags interval; elements = { 10.20.0.66/32, 127.0.0.0/8, 169.254.0.0/16, 172.17.0.0/16, 172.28.0.0/16 }; }
    set allowed_any { type ipv4_addr; flags interval; elements = { 10.20.0.0/16, 172.31.250.10/32 }; }
    set allowed_ports { type ipv4_addr . inet_service; elements = { 93.184.216.34 . 8443, 93.184.216.35 . 8443, 93.184.216.40 . 8081 }; }
    set dyn_any { type ipv4_addr; flags timeout; elements = { 1.2.3.4 timeout 60s }; }
    set dyn_ports { type ipv4_addr . inet_service; flags timeout; elements = { 1.2.3.5 . 443 timeout 90s }; }

    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        meta nfproto ipv6 drop
        iifname != "eth0" ct state established,related accept
        iifname "eth0" udp dport 5353 accept
        iifname "eth0" tcp dport { 5353, 8080 } accept
        log group 1 prefix "vg-deny-in " drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        meta nfproto ipv6 drop
        iifname "eth1" oifname "eth0" ct state established,related accept
        iifname "eth0" ip daddr @denied log group 1 prefix "vg-deny " drop
        iifname "eth0" oifname "eth1" ip daddr @allowed_any meta l4proto tcp accept
        iifname "eth0" oifname "eth1" ip daddr . tcp dport @allowed_ports accept
        iifname "eth0" oifname "eth1" ip daddr @dyn_any meta l4proto tcp accept
        iifname "eth0" oifname "eth1" ip daddr . tcp dport @dyn_ports accept
        iifname "eth0" log group 1 prefix "vg-deny " drop
    }

    chain output {
        type filter hook output priority 0; policy drop;
        oifname "lo" accept
        meta nfproto ipv6 drop
        oifname "eth0" ct state established,related accept
        ip daddr 172.28.0.5 tcp dport 8000 accept   # API ingest (cổng DUY NHẤT gateway tự gọi ngoài out_if)
        oifname "eth1" ip daddr @denied log group 1 prefix "vg-deny-out " drop
        oifname "eth1" ip daddr { 10.0.0.53 } udp dport 53 accept
        oifname "eth1" ip daddr { 10.0.0.53 } tcp dport 53 accept
        oifname "eth1" ip daddr @allowed_any meta l4proto tcp accept
        oifname "eth1" ip daddr . tcp dport @allowed_ports accept
        oifname "eth1" ip daddr @dyn_any meta l4proto tcp accept
        oifname "eth1" ip daddr . tcp dport @dyn_ports accept
        log group 1 prefix "vg-deny-out " drop
    }

    chain redirect_dns {
        type nat hook prerouting priority -100; policy accept;
        iifname "eth0" udp dport 53 redirect to :5353
        iifname "eth0" tcp dport 53 redirect to :5353
    }

    chain redirect_local_dns {
        type nat hook output priority -100; policy accept;
        ip daddr 127.0.0.1 udp dport 53 redirect to :5353
        ip daddr 127.0.0.1 tcp dport 53 redirect to :5353
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        oifname "eth1" masquerade
    }
}
